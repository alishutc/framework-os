[org.gnome.shell]
enabled-extensions=['logomenu@aryan_k', 'appindicatorsupport@rgcjonas.gmail.com', 'dash-to-dock@micxgx.gmail.com', 'blur-my-shell@aunetx', 'spotlight@nin']
favorite-apps=['com.google.Chrome.desktop', 'helium.desktop', 'org.gnome.Nautilus.desktop', 'steam.desktop', 'io.github.kolunmi.Bazaar.desktop']

[org.gnome.mutter]
center-new-windows=true
experimental-features=['scale-monitor-framebuffer']

[org.gnome.desktop.interface]
enable-hot-corners=false
clock-show-weekday=true
monospace-font-name="JetBrains Mono 11"

[org.gnome.desktop.wm.preferences]
button-layout=":minimize,maximize,close"

[org.gnome.desktop.wm.keybindings]
show-desktop=['<Super>d']
switch-windows=['<Alt>Tab']
switch-windows-backward=['<Shift><Alt>Tab']

[org.gnome.settings-daemon.plugins.media-keys]
home=['<Super>e']

[org.gtk.Settings.FileChooser]
sort-directories-first=true

[org.gtk.gtk4.Settings.FileChooser]
sort-directories-first=true

[org.gnome.shell.extensions.logo-menu]
use-custom-icon=true
custom-icon-path='/usr/share/icons/framework-logo-symbolic.svg'
menu-button-software-center='flatpak run io.github.kolunmi.Bazaar'
menu-button-terminal='ptyxis'

[org.gnome.shell.extensions.spotlight]
toggle-shortcut=['<Control>space']

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/framework/framework-13-light.jpg'
picture-uri-dark='file:///usr/share/backgrounds/framework/framework-13-dark.jpg'
picture-options='zoom'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/framework/framework-13-dark.jpg'
picture-options='zoom'

