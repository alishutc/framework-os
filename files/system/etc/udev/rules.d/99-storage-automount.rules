# Automount USB and MMC storage devices (Framework Storage Expansion Cards, external SSDs, SD cards)
ACTION=="add", SUBSYSTEMS=="usb|mmc", SUBSYSTEM=="block", ENV{ID_FS_USAGE}=="filesystem", RUN{program}+="/usr/bin/systemd-mount --no-block --automount=yes --collect --discover --options=exec $devnode"

# Clean up mounts on device removal
ACTION=="remove", SUBSYSTEMS=="usb|mmc", SUBSYSTEM=="block", RUN{program}+="/usr/bin/systemd-mount --umount $devnode"
